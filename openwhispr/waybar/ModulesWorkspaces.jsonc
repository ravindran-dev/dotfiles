// Waybar workspace configuration snippet
// Location: ~/.config/waybar/ModulesWorkspaces
//
// Maps OpenWhispr Control Panel to the official 3-bar waveform icon (󰺢 )
// while completely suppressing background Voice Recorder pills from polluting workspace tags.

{
  "hyprland/workspaces": {
    "window-rewrite": {
      "class<open-whispr> title<.*[Cc]ontrol [Pp]anel.*>": "󰺢 ",
      "title<.*[Cc]ontrol [Pp]anel.*>": "󰺢 ",
      "class<open-whispr> title<.*[Vv]oice [Rr]ecorder.*>": "",
      "class<open-whispr> title<.*[Mm]eeting [Nn]otification.*>": "",
      "title<.*[Vv]oice [Rr]ecorder.*>": "",
      "title<.*[Mm]eeting [Nn]otification.*>": "",
      "class<open-whispr>": "󰺢 "
    }
  }
}
